@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap");

:root {
    --bg: #060d1a;
    --surface: #0e1c30;
    --border: rgba(58, 159, 255, 0.15);
    --blue: #3a9fff;
    --gold: #d4a843;
    --text: #e8f0ff;
    --muted: #607a99;
    --input_hover: #060d1ad6;
    --input_border_hover: #607a99a6;
    --input_disabled: #415368;
}

main {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 2rem;
    position: relative;
}

main button {
    font-family: "Plus Jakarta Sans", sans-serif;
    border: 1px solid var(--border);
    border-radius: 100px;
    font-weight: 600;
    font-size: 14px;
    background-color: var(--surface);
    color: var(--gold);
    padding: 10px;
    transition: all 0.2s ease-in-out;
    width: max-content;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 1.5rem;
    right: 0;
}

main button:hover:not(:disabled) {
    cursor: pointer;
    background-color: var(--input_hover);
    border-color: var(--input_border_hover);
    color: var(--text);
}

main button:disabled {
    opacity: 0.4;
}

.main_section {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
    margin-top: 5rem;
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
}

.card {
    background: var(--surface);
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
    border: 1px solid var(--border);
    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    cursor: pointer;
}

.card:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
}

.card img {
    width: 100%;
    height: 175px;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--border);
}

.card-body {
    padding: 1.25rem;
}

.card-body h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 25px;
    color: var(--gold);
    margin: 0 0 0.75rem;
    text-transform: capitalize;
}

.card-body p {
    font-size: 10px;
    color: var(--text);
    line-height: 1.7;
    margin: 0 0 0.75rem;
}

.user_p {
    border: 1px solid var(--border);
    border-radius: 10px;
    width: fit-content;
    padding: 5px;
    align-items: center;
}

.case_empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.case_empty h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 40px;
    color: var(--gold);
}

.case_empty h2 {
    font-family: "Plus Jakarta Sans", sans-serif;
    color: var(--gold);
    font-style: italic;
}

/* ── IA ── */

.ia_section {
    width: 100%;
    padding: 2rem;
    margin-top: 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
}

.ia_titulo {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 28px;
    color: var(--gold);
    margin: 0 0 0.3rem;
}

.ia_sub {
    font-size: 12px;
    color: var(--muted);
    font-weight: 300;
    margin: 0 0 1.5rem;
}

.ia_row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
}

.ia_field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.ia_field label {
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.ia_field input {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 300;
    padding: 9px 12px;
    outline: none;
    transition: border-color 0.2s ease;
    width: 100%;
}

.ia_field input::placeholder { color: var(--muted); }
.ia_field input:hover { background: var(--input_hover); border-color: var(--input_border_hover); }
.ia_field input:focus { border-color: var(--blue); }

.ns_group {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.ns_pill {
    padding: 7px 14px;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s ease;
}

.ns_pill:hover { border-color: var(--input_border_hover); color: var(--text); }
.ns_pill.active { border-color: var(--gold); color: var(--gold); background: transparent; }

.ia_btn {
    font-family: "Plus Jakarta Sans", sans-serif;
    border: 1px solid var(--border);
    border-radius: 100px;
    font-weight: 600;
    font-size: 14px;
    background-color: var(--surface);
    color: var(--gold);
    padding: 10px 22px;
    transition: all 0.2s ease-in-out;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 0.5rem;
    position: static;
    width: max-content;
}

.ia_btn:hover:not(:disabled) {
    background-color: var(--input_hover);
    border-color: var(--input_border_hover);
    color: var(--text);
}

.ia_btn:disabled { opacity: 0.4; cursor: not-allowed; }

.ia_spinner {
    display: none;
    width: 13px;
    height: 13px;
    border: 2px solid rgba(212, 168, 67, 0.3);
    border-top-color: var(--gold);
    border-radius: 50%;
    animation: ia_spin 0.7s linear infinite;
}

@keyframes ia_spin { to { transform: rotate(360deg); } }

.ia_result {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
}

.ia_result:empty { display: none; }

.ia_result_head {
    padding: 8px 14px;
    background: rgba(58, 159, 255, 0.06);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
}

.ia_dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    opacity: 0.7;
    flex-shrink: 0;
}

.ia_tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--blue);
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.ia_result_body {
    padding: 1.25rem;
    font-size: 13px;
    line-height: 1.8;
    color: var(--text);
    font-weight: 300;
    white-space: pre-wrap;
}

@media (max-width: 480px) {
    .ia_row { grid-template-columns: 1fr; }
}
