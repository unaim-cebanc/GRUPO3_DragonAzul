DELIMITER ;;
CREATE DEFINER=`root`@`localhost` PROCEDURE `top_recetas`(IN p_limite INT)
BEGIN
    IF p_limite < 1 THEN
        SET p_limite = 10;
    END IF;

    SELECT * FROM vista_recetas_valoradas
    ORDER BY media_puntuacion DESC
    LIMIT p_limite;
END ;;
DELIMITER ;
